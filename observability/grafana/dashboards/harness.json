{
  "uid": "harness", "title": "AI Harness", "schemaVersion": 39, "version": 1,
  "tags": ["ai", "debugging", "tokens"], "timezone": "browser", "refresh": "10s",
  "time": {"from": "now-1h", "to": "now"},
  "templating": {"list": [{"name": "mode", "label": "Execution mode", "type": "custom", "query": "model,demo", "current": {"text": "model", "value": "model"}, "options": [{"text": "model", "value": "model", "selected": true}, {"text": "demo", "value": "demo", "selected": false}]}]},
  "panels": [
    {"id": 1, "title": "Completed runs", "type": "stat", "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4}, "datasource": {"type": "prometheus", "uid": "harness-prometheus"}, "targets": [{"refId": "A", "expr": "sum(harness_runs_total{mode=\"$mode\"})"}], "options": {"reduceOptions": {"calcs": ["lastNotNull"]}}},
    {"id": 2, "title": "Verified fixes / completed runs", "type": "stat", "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4}, "datasource": {"type": "prometheus", "uid": "harness-prometheus"}, "targets": [{"refId": "A", "expr": "100 * sum(harness_runs_total{mode=\"$mode\",status=\"verified_candidate\"}) / clamp_min(sum(harness_runs_total{mode=\"$mode\"}), 1)"}], "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100}}, "options": {"reduceOptions": {"calcs": ["lastNotNull"]}}},
    {"id": 3, "title": "Estimated tokens used", "type": "stat", "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4}, "datasource": {"type": "prometheus", "uid": "harness-prometheus"}, "targets": [{"refId": "A", "expr": "sum(harness_tokens_estimated_total{mode=\"$mode\"})"}], "options": {"reduceOptions": {"calcs": ["lastNotNull"]}}},
    {"id": 4, "title": "Source context reduction (estimate)", "description": "Against eligible full source, not provider billing or a competing agent.", "type": "stat", "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4}, "datasource": {"type": "prometheus", "uid": "harness-prometheus"}, "targets": [{"refId": "A", "expr": "100 * sum(harness_context_tokens_avoided_estimated_total{mode=\"$mode\"}) / clamp_min(sum(harness_context_full_tokens_estimated_total{mode=\"$mode\"}), 1)"}], "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100}}, "options": {"reduceOptions": {"calcs": ["lastNotNull"]}}},
    {"id": 5, "title": "Run outcomes", "type": "timeseries", "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "harness-prometheus"}, "targets": [{"refId": "A", "expr": "harness_runs_total{mode=\"$mode\"}", "legendFormat": "{{status}}"}]},
    {"id": 6, "title": "Estimated input and output tokens", "type": "timeseries", "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "harness-prometheus"}, "targets": [{"refId": "A", "expr": "harness_input_tokens_estimated_total{mode=\"$mode\"}", "legendFormat": "input estimate"}, {"refId": "B", "expr": "harness_output_tokens_estimated_total{mode=\"$mode\"}", "legendFormat": "output estimate"}]},
    {"id": 7, "title": "Mean run duration", "type": "stat", "gridPos": {"x": 0, "y": 12, "w": 8, "h": 5}, "datasource": {"type": "prometheus", "uid": "harness-prometheus"}, "targets": [{"refId": "A", "expr": "sum(harness_duration_seconds_total{mode=\"$mode\"}) / clamp_min(sum(harness_runs_total{mode=\"$mode\"}), 1)"}], "fieldConfig": {"defaults": {"unit": "s"}}, "options": {"reduceOptions": {"calcs": ["lastNotNull"]}}},
    {"id": 8, "title": "Provider-reported tokens", "description": "Only reported calls. Zero may mean usage is unavailable; see run reports for coverage.", "type": "timeseries", "gridPos": {"x": 8, "y": 12, "w": 16, "h": 5}, "datasource": {"type": "prometheus", "uid": "harness-prometheus"}, "targets": [{"refId": "A", "expr": "harness_provider_input_tokens_total{mode=\"$mode\"}", "legendFormat": "reported input"}, {"refId": "B", "expr": "harness_provider_output_tokens_total{mode=\"$mode\"}", "legendFormat": "reported output"}]},
    {"id": 9, "title": "Verified fixes by model", "description": "Compare only matching task sets and budgets. No standardized benchmark score is implied.", "type": "timeseries", "gridPos": {"x": 0, "y": 17, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "harness-prometheus"}, "targets": [{"refId": "A", "expr": "harness_model_verified_total{mode=\"$mode\"}", "legendFormat": "{{provider}} / {{model}}"}]},
    {"id": 10, "title": "Reported tokens by model", "type": "timeseries", "gridPos": {"x": 12, "y": 17, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "harness-prometheus"}, "targets": [{"refId": "A", "expr": "harness_model_tokens_reported_total{mode=\"$mode\"}", "legendFormat": "{{provider}} / {{model}}"}]}
  ]
}
